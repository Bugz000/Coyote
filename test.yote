A := 0
B := 0
V := [[-12,-12,-12],[12,-12,-12],[12,12,-12],[-12,12,-12],[-12,-12,12],[12,-12,12],[12,12,12],[-12,12,12]]
E := [[0,1],[1,2],[2,3],[3,0],[4,5],[5,6],[6,7],[7,4],[0,4],[1,5],[2,6],[3,7]]
Loop (250) {
    PX := []
    PY := []
    Loop (V) {
        PX := Push(PX, Round(24 + (A_Val[0] * Cos(B) + (A_Val[1] * Sin(A) + A_Val[2] * Cos(A)) * Sin(B)) * 0.95))
        PY := Push(PY, Round(11 + (A_Val[1] * Cos(A) - A_Val[2] * Sin(A)) * 0.45))
    }
    buf := StrSplit(Repeat(" ", 1056), "")
    Loop (E) {
        dx := PX[A_Val[1]] - PX[A_Val[0]]
        dy := PY[A_Val[1]] - PY[A_Val[0]]
        s := Max(Max(Abs(dx), Abs(dy)), 1)
        Loop (s + 1)
            buf[Round(PY[A_Val[0]] + dy * (A_index-1) / s) * 48 + Round(PX[A_Val[0]] + dx * (A_index-1) / s)] := "#"
    }
    Clear()
    Loop (22)
        Print(Join(Slice(buf, (A_index-1) * 48, A_index * 48), ""))
    A := A + 0.08
    B := B + 0.12
}